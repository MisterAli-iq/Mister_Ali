rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000));
    }

    function isValidUserFavorite(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.songId is string && data.songId.size() >= 1 && data.songId.size() <= 100 &&
             data.songTitle is string && data.songTitle.size() >= 1 && data.songTitle.size() <= 200;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow delete: if isOwner(userId) && isValidId(userId);

      match /favorites/{songId} {
        allow get: if isOwner(userId) && isValidId(songId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(songId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().songId == songId &&
                         incoming().keys().hasAll(['userId', 'songId', 'songTitle', 'addedAt']) &&
                         incoming().keys().hasOnly(['userId', 'songId', 'songTitle', 'addedAt']) &&
                         incoming().addedAt is timestamp && incoming().addedAt <= request.time &&
                         isValidUserFavorite(incoming());

        allow delete: if isOwner(userId) && isValidId(songId);
      }
    }
  }
}
